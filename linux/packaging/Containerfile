# Build a portable Neptune AppImage.
#
# The whole point of this image is the glibc version. Build on a modern host and the artifact
# only runs on similarly modern systems; build here and it runs on this release and anything
# newer. Debian 12 gives glibc 2.36 and a stable Python 3.11, which upstream requires
# (`requires-python = ">=3.11"`). That covers Debian 12+, Ubuntu 23.04/24.04+, and Fedora 37+.
#
# Ubuntu 22.04 would reach further (glibc 2.35) but its only 3.11 is a release candidate, so it
# is not a base I want to ship a release from.
#
# Build the image from the repo root:
#   docker build -t neptune-appimage-builder -f linux/packaging/Containerfile .
# then run it (linux/packaging/run.sh does both) to write dist/Neptune.AppImage on the host.
FROM debian:12

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    # appimagetool is itself an AppImage and containers have no FUSE, so let it self-extract.
    APPIMAGE_EXTRACT_AND_RUN=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-venv python3-dev \
        build-essential pkg-config \
        mingw-w64 \
        binutils file curl ca-certificates xz-utils \
        xvfb xauth fonts-dejavu-core \
        libegl1 libgl1 libglib2.0-0 libdbus-1-3 libfontconfig1 libfreetype6 \
        libxkbcommon0 libxkbcommon-x11-0 libx11-xcb1 libxrender1 libxi6 libxtst6 \
        libsm6 libice6 \
        libxcb1 libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
        libxcb-randr0 libxcb-render-util0 libxcb-shape0 libxcb-xinerama0 \
        libxcb-xfixes0 libxcb-sync1 libxcb-xkb1 libpulse0 libasound2 libnss3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Install the pinned dependencies in their own layer, keyed only on the lock file. Source edits
# then rebuild in seconds instead of re-downloading PySide6.
COPY linux/requirements.lock linux/requirements.lock
RUN python3 -m venv .venv \
    && .venv/bin/python -m pip install --upgrade pip \
    && .venv/bin/python -m pip install -r linux/requirements.lock pyinstaller

COPY . .

CMD ["bash", "linux/packaging/build.sh"]
